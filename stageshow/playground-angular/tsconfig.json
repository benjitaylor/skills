{
  "compilerOptions": {
    // kit-angular/ and examples-angular/ sit outside this folder; their imports resolve here
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "outDir": "dist/out-tsc",
    "types": [],
    "paths": {
      "@angular/*": ["./node_modules/@angular/*"],
      "rxjs": ["./node_modules/rxjs"],
      "rxjs/*": ["./node_modules/rxjs/*"],
      "tslib": ["./node_modules/tslib"]
    }
  },
  "angularCompilerOptions": {
    "strictTemplates": true,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "extendedDiagnostics": { "defaultCategory": "error" }
  },
  "files": ["src/main.ts"],
  "include": ["src/**/*.ts", "../kit-angular/**/*.ts", "../examples-angular/**/*.ts", "../kit/act.ts", "../kit/clock.ts", "../kit/core.ts", "../kit/ease.ts", "../kit/measure.ts", "../kit/util.ts"]
}
