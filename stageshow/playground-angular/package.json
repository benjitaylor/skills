    "@angular/core": "~20.3.0",
    "@angular/platform-browser": "~20.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.0"
  },
  "devDependencies": {
    "@angular/build": "~20.3.0",
    "@angular/cli": "~20.3.0",
    "@angular/compiler-cli": "~20.3.0",
    "typescript": "~5.9.0"
  }
}
