{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "types": ["jest"],
    "noUncheckedIndexedAccess": false
  },
  "include": [
    "kit/**/*.ts",
    "kit/**/*.tsx",
    "playground/**/*.ts",
    "playground/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "demo/**/*.ts",
    "demo/**/*.tsx",
    "review/**/*.ts",
    "review/**/*.tsx",
    "examples/**/*.ts",
    "examples/**/*.tsx"
  ]
}
